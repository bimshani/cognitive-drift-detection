                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.4</rdf:first>
                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </swrl:arguments>
                                                                    </rdf:Description>
                                                                </rdf:first>
