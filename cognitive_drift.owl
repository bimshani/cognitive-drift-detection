    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Fewer than two sessions recorded: progression cannot be judged yet.</rdfs:comment>
        <rdfs:label>R41_InsufficientHistory</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionCount"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionStatus"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InsufficientHistory_Status"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Added after pilot testing: all-or-nothing thinking and catastrophizing together imply at least mild academic stress even when the word-list measures are low. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R42_DistortionPair_MildStress</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Added after pilot testing: all-or-nothing thinking, catastrophizing and overgeneralization together imply moderate academic stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R43_DistortionTriad_ModerateStress</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Overgeneralization_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#b1">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="urn:swrl:var#b2">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Added in v2: self-reported mental exhaustion together with physical restlessness or distractibility. Uses checklist items B7, B15 and B2, which no earlier rule read.</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion"/>
    </owl:NamedIndividual>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Added in v2: giving up on study tasks early together with a feeling that studying is hopeless (checklist items B11 and B12).</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement"/>
    </owl:NamedIndividual>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>Added in v2: distractibility together with forgetfulness (checklist items B2 and B5).</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse"/>
    </owl:NamedIndividual>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: mental exhaustion (B7) with physical restlessness (B15). Pending supervisor review.</rdfs:comment>
        <rdfs:label>R44_MentalExhaustion_Restless</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasMentalExhaustionReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b2"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasPhysicalRestlessnessReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b2"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: mental exhaustion (B7) with distractibility (B2). Pending supervisor review.</rdfs:comment>
        <rdfs:label>R45_MentalExhaustion_Distracted</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasMentalExhaustionReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b2"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasDistractionReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b2"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: giving up early (B11) with hopelessness about studying (B12). Pending supervisor review.</rdfs:comment>
        <rdfs:label>R46_Disengagement</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasEarlyGiveUpReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasHopelessnessStudyReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: distractibility (B2) with forgetfulness (B5). Pending supervisor review.</rdfs:comment>
        <rdfs:label>R47_DistractionLapse</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasDistractionReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#b2"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasForgetfulnessReport"/><swrl:argument1 rdf:resource="urn:swrl:var#b2"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: mental exhaustion under a High workload implies at least mild stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R48_MildStress_Exhaustion</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasWorkloadLevel"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#w"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#equal"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#w"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first>High</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: disengagement together with mental exhaustion implies moderate stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R49_ModerateStress_Disengagement</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: disengagement, mental exhaustion and catastrophizing together imply severe stress. A second route to severe stress that does not depend on the helplessness score. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R50_SevereStress_Hopeless</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: distraction with forgetfulness plus mental exhaustion implies early drift. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R51_EarlyDrift_Fatigue</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: distraction lapse, attention loss and mental exhaustion together imply moderate drift without needing speech. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R52_ModerateDrift_Fatigue</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DistractionLapse_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: closes a gap. Exam anxiety under a High workload previously produced no state, because R13 excludes High workload and R15 needs perceived overload. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R53_MildStress_ExamAnxiety_HighWorkload</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ExamAnxiety_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasWorkloadLevel"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:resource="urn:swrl:var#w"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#equal"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#w"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first>High</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: rigid should-statements together with all-or-nothing thinking imply at least mild stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R54_MildStress_Perfectionism</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ShouldStatements_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: self-blame (personalization) together with all-or-nothing thinking implies at least mild stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R55_MildStress_SelfBlame</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Personalization_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v2: catastrophizing, working-memory lapse, attention loss and mental exhaustion together imply severe drift. A route to severe drift that needs neither speech nor the helplessness score. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R56_SevereDrift_NoSpeech</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WorkingMemoryLapse_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalExhaustion_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehaviourGroupCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Added in v3: how many of the five checklist groups (attention, memory, energy, avoidance, physical) have at least one item ticked in this session. Counted by the application from the checklist and asserted as an observed fact, like the absolutist term count.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#WidespreadStrain">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Added in v3: self-reported difficulties in three or more of the five checklist groups, even when no single pair of items completes another indicator.</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#WidespreadStrain_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WidespreadStrain"/>
    </owl:NamedIndividual>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v3: three or more of the five checklist groups have a ticked item. Closes a gap where scattered ticks completed no pair rule. Provisional threshold, pending calibration and supervisor review.</rdfs:comment>
        <rdfs:label>R57_WidespreadStrain</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehaviourGroupCount"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WidespreadStrain_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v3: widespread strain tied to a specific academic event implies at least mild stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R58_MildStress_WidespreadStrain</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WidespreadStrain_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#sess"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_isLinkedToSpecificEvent"/><swrl:argument1 rdf:resource="urn:swrl:var#sess"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v4: helplessness about the workload together with perceived overload implies at least moderate stress, without needing exam anxiety or physical complaints. Found in synthetic testing: severe-sounding language-led cases previously received no state. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R59_ModerateStress_Overwhelmed</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#HelplessnessAboutWorkload_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PerceivedOverload_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v4: helplessness, perceived overload, disengagement and catastrophizing together imply severe stress. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R60_SevereStress_Overwhelmed</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#HelplessnessAboutWorkload_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PerceivedOverload_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Disengagement_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v4: attention loss together with slowed thinking implies early drift, without needing a speech recording. Pending supervisor review.</rdfs:comment>
        <rdfs:label>R61_EarlyDrift_AttentionSlowing</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SlowedThinking_Ind"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasChecklistTickCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Added in v5 (calibration round 1): total number of the 15 checklist items ticked in this session. Counted by the application and asserted as an observed fact.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasStressEvidenceScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Added in v5 (calibration round 1): 2 x min(stress words in the self-talk, 3) + 1 if sentiment &lt; -0.5 + 1 if 8 or more checklist items are ticked. Computed by the application from observed facts; the thresholds in R65-R67 were fitted on a small doctor-labelled pilot set and are pending supervisor review.</rdfs:comment>
    </owl:DatatypeProperty>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v5: three or more checklist items ticked implies at least early drift. Fitted on 39 doctor-labelled pilot sessions; provisional, pending supervisor review.</rdfs:comment>
        <rdfs:label>R62_EarlyDrift_ChecklistBreadth</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasChecklistTickCount"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v5: six or more checklist items ticked implies at least moderate drift. Fitted on 39 doctor-labelled pilot sessions; provisional, pending supervisor review.</rdfs:comment>
        <rdfs:label>R63_ModerateDrift_ChecklistBreadth</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasChecklistTickCount"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v5: eleven or more checklist items ticked implies severe drift. Fitted on 39 doctor-labelled pilot sessions; provisional, pending supervisor review.</rdfs:comment>
        <rdfs:label>R64_SevereDrift_ChecklistBreadth</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasChecklistTickCount"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v5: stress evidence score of 1 or more implies at least mild stress. Fitted on 39 doctor-labelled pilot sessions; provisional, pending supervisor review.</rdfs:comment>
        <rdfs:label>R65_MildStress_EvidenceScore</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasStressEvidenceScore"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#n"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#n"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>v5: stress evidence score of 3 or more implies at least moderate stress. Fitted on 39 doctor-labelled pilot sessions; provisional, pending supervisor review.</rdfs:comment>
