<?xml version="1.0"?>
<rdf:RDF xmlns="http://kduresearch.ac.lk/ontologies/cognitive-drift#"
     xml:base="http://kduresearch.ac.lk/ontologies/cognitive-drift"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift">
        <owl:versionIRI rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift/1.0"/>
        <rdfs:comment>An OWL 2 ontology for detecting early cognitive drift and academic stress in university students using self-talk, speech, and self-reported behavioral signals. Developed at the General Sir John Kotelawala Defence University, Faculty of Computing, Department of Computer Science.</rdfs:comment>
        <rdfs:comment>Creator: NTPGB Upethra - D/BCS/23/0021
</rdfs:comment>
        <rdfs:comment>This ontology is developed in alignment with the Mental Functioning Ontology (MFO) and the Cognitive Atlas. It is not a clinical diagnostic tool.</rdfs:comment>
        <rdfs:comment>Year: 2026</rdfs:comment>
        <rdfs:label>Cognitive Drift and Academic Stress Ontology

</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#evidencedBy -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#evidencedBy">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>Links an asserted indicator back to the raw input that caused it. Critical for explainability ; tells you which self-talk phrase or behavioral report triggered a specific indicator.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator"/>
        <rdfs:comment>Connects a student to the stress or drift indicators inferred from their input by SWRL rules. This property is populated by the reasoner; not manually.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasBehavioralSignal">
        <rdfs:subPropertyOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInputSignal"/>
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Connects a session specifically to the student&apos;s self-reported behavioral checklist responses.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasExplanation -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasExplanation">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:comment>Connects a student to the explanation object that records  why a particular state was inferred and what evidence triggered it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState"/>
        <rdfs:comment>Connects a student to thei  final inferred state such as MildStress, ModerateDrift etc. populated by SWRL rules.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInputSignal -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInputSignal">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>General parent property connecting a session to any type of input. Used for general queries like &quot;does this session have any input?&quot;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasProgressionRecord -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasProgressionRecord">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression"/>
        <rdfs:comment>Connects a student to their progression record across multiple sessions to tracks whether their condition is improving, worsening,  or stable over time.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasRecommendedAction -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasRecommendedAction">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput"/>
        <rdfs:comment>Connects a student to the recommended support output action. Domain is Student to align with SWRL rules R23-R27 which assign this property directly to Student individuals.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSelfTalkEntry -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSelfTalkEntry">
        <rdfs:subPropertyOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInputSignal"/>
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:comment>Connects a session specifically  to the student&apos;s written or spoken self-talk text entry.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:comment>Connects a student to their submitted academic sessions.One student can have many sessions.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionStatus -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionStatus">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <rdfs:comment>Connects a student to the outcome status of their session such as NoIndicatorsDetected,  IncompleteInput, or MonitoringRequired.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSpeechSample -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSpeechSample">
        <rdfs:subPropertyOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInputSignal"/>
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:comment>Connects a session specifically to the student&apos;s short speech recording and its transcription.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#isAmplifiedBy -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#isAmplifiedBy">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Captures that cognitive drift indicators are made worse by co-occurring academic stress indicators. For example AttentionLoss is amplified ExamAnxiety when both are present.
</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#mayProgressTo -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#mayProgressTo">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState"/>
        <rdfs:comment>Captures the pathway from stress to drift. Represents that a stress state, if unaddressed, may progress into a drift state over time.
</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#supportedBy -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#supportedBy">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>Links an inferred state directly back to the raw input signals that support it across modalities. Used for full end-to-end traceability in explanations.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#triggeredBy -->

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#triggeredBy">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator"/>
        <rdfs:comment>Links an inferred state back to the specific indicators that caused the reasoner to assign it. For example ModerateDrift was triggered by AttentionLoss and WorkingMemoryLapse.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasDistractionReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasDistractionReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionFocusBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B2. True if the student reported frequently getting distracted by their phone or surroundings during their study session. Contributes to the AttentionLoss drift indicator alongside focus difficulty.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasFocusDifficultyReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasFocusDifficultyReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionFocusBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B1. True if the student reported difficulty staying focused for more than 10 minutes during their study session. Combined  with attention_hasZoningOutReport  to assert the AttentionLoss drift indicator.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasZoningOutReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#attention_hasZoningOutReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionFocusBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B3. True if the student reported zoning out during lectures or while reading study material. Combined with attention_hasFocusDifficultyReport to assert the AttentionLoss drift indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasEarlyGiveUpReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasEarlyGiveUpReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AvoidanceBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B11. True if the student reported giving up on a study task earlier than they intended to. Contributes to HelplessnessAboutWorkload and PerceivedOverload indicator  inference when combined with workload level.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasHopelessnessStudyReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasHopelessnessStudyReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AvoidanceBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B12. True if the student reported feeling like there was no point in continuing to study. Strong signal for EmotionalReasoning and HelplessnessAboutWorkload indicator inference. Most severe avoidance behavior signal.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasTaskPostponementReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#avoidance_hasTaskPostponementReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AvoidanceBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B10. True if the student reported avoiding or postponing study tasks they had originally planned to complete. Contributes to HelplessnessAboutWorkload indicator when combined with high helplessness
score in self-talk or speech.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasClearThoughtDiffReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasClearThoughtDiffReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalEnergyBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B9. True if the  student reported struggling to  form clear thoughts or ideas during studying. Combined with energy_hasSlowedThinkingReport
 to assert the SlowedThinking drift indicator.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasMentalExhaustionReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasMentalExhaustionReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalEnergyBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B7. True if the student reported feeling mentally exhausted after only a short study period. Contributes to SlowedThinking and PhysicalStressComplaint indicator inference when combined with other energy behavior signals.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasSlowedThinkingReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#energy_hasSlowedThinkingReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalEnergyBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B8. True if the student reported feeling their thinking was slower than usual during the session. Combined with energy_hasClearThoughtDiffReport and slow speech pace to assert  the SlowedThinking drift indicator.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasCounselorFacingMessage -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasCounselorFacingMessage">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the detailed summary shown to academic counselors or support staff. Contains the inferred state, triggered indicators, evidence phrases, and recommended action. More detailed than the student facing message.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasEvidencePhrase -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasEvidencePhrase">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the specific phrase or behavioral item from the student&apos;s input that served as key evidence for the inference. Critical for explainability that allows counselors
to see exactly what the student said or reported that triggered  the system output.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasInferredStateLabel -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasInferredStateLabel">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the human readable label of the inferred state assigned to the student such as ModerateDrift or SevereStress. Used to generate the output message displayed on the frontend interface.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasStudentFacingMessage -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasStudentFacingMessage">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the awareness message shown directly to the student on the  frontend. Written in supportive non-clinical language to avoid stigma. Does not use diagnostic terminology under any circumstance.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasTriggeredRuleID -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_hasTriggeredRuleID">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the identifier of the SWRL rule that fired to produce the inferred state. For example R19 for ModerateDrift. Enables full traceability from output back to
 the specific reasoning rule that was applied.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_isClinicallyDiagnostic -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#explanation_isClinicallyDiagnostic">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Always set to false. Explicitly records that the system output is not a clinical diagnosis and should not be used as a substitute for professional psychological assessment. Directly addresses the system scope limitation competency question.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasDiscipline -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasDiscipline">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the academic discipline of the student. Expected values are Computing, Engineering, Science, or other STEM related fields.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasName -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasName">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Tracks the total number of sessions submitted by the student. Used to determine if enough data exists for progression tracking across multiple sessions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#hasYearOfStudy -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasYearOfStudy">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasForgetfulnessReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasForgetfulnessReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MemoryBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B5. True if the student reported forgetting what they studied shortly after studying it. Contributes to the WorkingMemoryLapse drift indicator alongside re-reading behavior.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasMindBlankReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasMindBlankReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MemoryBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>checklist item B6. True if the student reported their mind going blank when trying to recall something they had previously studied. Combined with memory_hasReReadingReport to assert the WorkingMemoryLapse drift indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasReReadingReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#memory_hasReReadingReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MemoryBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B4. True if the student reported re-reading the same content multiple times without understanding it. Combined with memory_hasMindBlankReport to assert  the WorkingMemoryLapse drift indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasHeadacheReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasHeadacheReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B13. True if the student reported experiencing a headache or physical tension during their study session. Combined with physical_hasSleepDifficultyReport  to assert the PhysicalStressComplaint academic stress indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasPhysicalRestlessnessReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasPhysicalRestlessnessReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B15. True if the student reported feeling physically  restless or unable to sit still  during studying. Contributes to ExamAnxiety and PhysicalStressComplaint indicator inference alongside other physical behavior signals.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasSleepDifficultyReport -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#physical_hasSleepDifficultyReport">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalBehavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Checklist item B14. True if the student reported difficulty sleeping  due to academic worries. Combined  with physical_hasHeadacheReport to assert PhysicalStressComplaint and contributes to ExamAnxiety  indicator inference.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasCurrentState -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasCurrentState">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the inferred state label from the student&apos;s most recent session. Compared with progression_hasPreviousState to calculate the progression direction across sessions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasPreviousState -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasPreviousState">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the inferred state label from the student&apos;s previous session. Used alongside progression_hasCurrentState to determine whether the student&apos;s
 condition is improving, worsening, or stable between sessions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasProgressionDirection -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasProgressionDirection">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the direction of change in the student&apos;s condition across sessions. Expected values are Improving, Worsening, or Stable. Answers the competency question about whether a student&apos;s condition has changed between sessions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasSessionSpan -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#progression_hasSessionSpan"/>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasAbsolutistTermCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasAbsolutistTermCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Stores the count of absolutist terms detected in the self-talk text such as always, never, completely, nothing, and everything. High counts indicate AllOrNothingThinking or Overgeneralization distortions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasShouldStatementCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasShouldStatementCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Stores the count of rigid-obligation terms detected in the self-talk text such as should, must, and have to. High counts combined with negative sentiment indicate the ShouldStatements distortion (Beck, 1979). Added to close the open issue that ShouldStatements had a class and individual but no producing rule.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasPersonalizationCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasPersonalizationCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Stores the count of self-blame phrases detected in the self-talk text such as my fault, I ruined it, and I let everyone down. Combined with negative sentiment, indicates the Personalization distortion (Beck, 1979). Added to close the open issue that Personalization had a class and individual but no producing rule.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasCatastrophizingScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasCatastrophizingScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Stores the degree to which the student&apos;s self-talk contains catastrophizing language patterns such as worst case thinking or extreme negative outcome prediction. Range is 0.0 to 1.0. Used to infer the Catastrophizing drift indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasHelplessnessScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasHelplessnessScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Stores the degree of helplessness language detected in the self-talk text. Range is 0.0 to 1.0. Captures phrases like I cannot do this or there is no point. Used to infer HelplessnessAboutWorkload indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasNegativeLanguageScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasNegativeLanguageScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Stores the proportion of negative language detected in the self-talk text by the NLP pipeline. Range is 0.0 to 1.0. A score above 0.6 triggers stress related SWRL rules.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasOvergeneralizationScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasOvergeneralizationScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Stores the degree to which the student&apos;s self-talk contains overgeneralization patterns such as applying one negative event to all situations. Range is 0.0 to 1.0.Used to infer the Overgeneralization drift indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasRawText -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasRawText">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the original unprocessed text submitted by the student as their self-talk entry. This is the primary input to the NLP pipeline for feature extraction.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasSentimentScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasSentimentScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Stores the overall sentiment polarity score of the self-talk text extractedby the  NLP pipeline. Range is -1.0  (most negative) to +1.0 (most positive). Used in multiple SWRL rules to detect negative emotional language patterns.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasSubjectSpecific -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#selfTalk_hasSubjectSpecific">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the student&apos;s self-talk is focused on a specific subject or task rather than general academic life. True means subject specific stress, false means general. Answers competency question about whether stress is task specific.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasActivityType -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasActivityType">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes the type of academic activity the student was engaged in during the session. Expected values are ExamPreparation, AssignmentWork, Lecture, or SelfStudy.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasSessionDate -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasSessionDate">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Records the date and time when the student submitted the session input. Used for longitudinal tracking and progression analysis across sessions.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasWorkloadLevel -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_hasWorkloadLevel">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the student&apos;s perceived academic workload during the session. Expected values are Low, Moderate, or High. Used in SWRL rules to infer PerceivedOverload indicator.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#session_isLinkedToSpecificEvent -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_isLinkedToSpecificEvent">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the student&apos;scurrent stress is associated with a specific upcoming academic event such as an exam or assignment deadline. True means event specific, false means general ongoing stress.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#session_isStressAcuteOrPersistent -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#session_isStressAcuteOrPersistent">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures whether the student&apos;s reported stress is linked to a specific short term event or has been ongoing across multiple sessions. Expected values are
Acute or Persistent.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasAbsolutistTermCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasAbsolutistTermCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Count of absolutist terms detected in the transcribed speech text such as always, never, and completely. Compared with the same score in SelfTalkEntry to identify whether absolutist thinking is more prominent in spoken or written  expression.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasCatastrophizingScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasCatastrophizingScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Degree of catastrophizing language detected in the transcribed speech text. Combined with speech_hasSpeechPace and speech_hasHesitationCount to strengthen Catastrophizing drift indicator inference from the speech modality. Range is 0.0 to 1.0.
</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasHelplessnessScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasHelplessnessScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Degree of helplessness language detected in the transcribed speech text. Enables comparison between spoken and written helplessness expression patterns. A consistently high score across both modalities strengthens HelplessnessAboutWorkload indicator inference. Range is 0.0 to 1.0.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasHesitationCount -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasHesitationCount">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of hesitations, pauses, or filler words such as um and uh detected in the audio recording before transcription. A count above 3 combined with other indicators contributes to ModerateDrift inference.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasNegativeLanguageScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasNegativeLanguageScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Proportion of negative language detected in the transcribed speech text by the NLP pipeline. Analyzed independently from the written self-talk to enable modality specific comparison of negative language patterns. Range is 0.0 to 1.0.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasOvergeneralizationScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasOvergeneralizationScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Degree of overgeneralization language detected in the transcribed speech text. Analyzed separately from written self-talk to capture modality specific differences in cognitive distortion expression between spoken and written language. Range is 0.0 to 1.0.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSentimentScore -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSentimentScore">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Sentiment polarity score extracted by the NLP pipeline from the transcribed speech text. Analyzed separately from the written self-talk entry to capture differences between spoken and   written emotional expression. Range is -1.0 to +1.0.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSpeechAvailable -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSpeechAvailable">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the student provided a speech recording for this session. False means the student skipped the speech modality. Used to trigger IncompleteInput session status and handle unimodal inference gracefully in SWRL rules.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSpeechPace -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasSpeechPace">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures the detected pace of the student&apos;s speech from the audio recording before transcription. Expected values are Slow, Normal,  or Fast. Slow pace combined with behavioral signals contributes to SlowedThinking indicator inference.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasToneIndicator -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasToneIndicator">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Overall emotional tone detected in the student&apos;s voice from the audio recording before transcription.  Expected values are Flat, Anxious,or Normal. Flat or Anxious tone  contributes to stress and drift  indicator inference alongside linguistic features.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasTranscribedText -->

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasTranscribedText">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the raw text transcription of the student&apos;s speech recording produced by the ASR pipeline. This transcription is then passed through the same NLP pipeline as the written self-talk to extract  linguistic features independently.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicSession">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Represents a single study session submitted by a student, containing the date, activity type, workload level, and all associated input signals.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion characterized by absolutist thinking with no middle ground, evidenced by absolutist terms such as always, never, completely, 
and nothing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionFocusBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionFocusBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Self-reported behaviors related to attention and focus difficulties during study, including focus difficulty, distraction, and zoning out.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>Indicates a student&apos;s reduced ability to sustain focused attention during academic tasks.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AvoidanceBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AvoidanceBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Self-reported behaviors indicating academic task avoidance patterns, including task postponement, early give up, and hopelessness about studying.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion where the student consistently predicts or imagines the worst possible outcome for academic situations.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator"/>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#CounselorAlert -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#CounselorAlert">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput"/>
        <rdfs:comment>An alert generated for academic support staff or counselors when a student reaches a Moderate or Severe inferred state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#DeadlinePressure -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#DeadlinePressure">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates stress arising from approaching assignment or project deadlines in the academic context.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState"/>
        <rdfs:comment>Represents an inferred state where cognitive drift indicators are present, either alongside or independent of academic stress indicators.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift"/>
        <rdfs:comment>Inferred when one or two cognitive drift indicators co-occur with stress indicators, suggesting the student is beginning to experience cognitive changes.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#EmotionalReasoning -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#EmotionalReasoning">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion where the student treats their negative feelings as evidence of objective academic failure. </rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ExamAnxiety -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#ExamAnxiety">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates anxiety specifically triggered by upcoming academic evaluation events such as exams or tests. </rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Explanation">
        <rdfs:comment>Represents the structured explanation produced by the system describing which indicators and rules triggered a specific inferred state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Fatigue -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Fatigue">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalStressComplaint"/>
        <rdfs:comment>Self-reported physical or mental fatigue associated with sustained academic demands.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Headache -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Headache">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalStressComplaint"/>
        <rdfs:comment>A self-reported headache or physical tension occurring during or after academic work.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#HelplessnessAboutWorkload -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#HelplessnessAboutWorkload">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates a student&apos;s expressed sense of helplessness or inability to cope with academic demands.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#IncompleteInput -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#IncompleteInput">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MonitoringRequired"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#NoIndicatorsDetected"/>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Represents the inferred mental state of a student as determined by SWRL reasoning rules applied to detected indicators.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>The parent class for all raw input data collected from a student during an academic session.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MemoryBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MemoryBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Self-reported behaviors indicating working memory problems during study, including re-reading without understanding, forgetfulness, and mind going blank.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalEnergyBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalEnergyBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Self-reported behaviors indicating reduced mental energy or cognitive fatigue, including mental exhaustion, slowed thinking, and difficulty forming clear thoughts.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalFilter -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalFilter">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion where the student focuses exclusively on negative academic experiences while filtering out positive ones. Based on Beck&apos;s 
cognitive distortion taxonomy.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MentalStateIndicator">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>The parent class for all detected indicators of academic stress or cognitive drift derived from student input signals.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress"/>
        <rdfs:comment>Inferred when one or two academic stress indicators are present with no cognitive drift indicators detected.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift"/>
        <rdfs:comment>Inferred when multiple cognitive drift indicators co-occur across behavioral and linguistic modalities, suggesting significant cognitive impact.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateStress">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress"/>
        <rdfs:comment>Inferred when two or more academic stress indicators co-occur, suggesting the student is under significant academic pressure.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#MonitoringRequired -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#MonitoringRequired">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <owl:disjointWith rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#NoIndicatorsDetected"/>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#NoIndicatorsDetected -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#NoIndicatorsDetected">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Overgeneralization -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Overgeneralization">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion where the student draws broad negative conclusions from a single academic event or failure. </rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#PerceivedOverload -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PerceivedOverload">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates a student&apos;s perception that their academic workload exceeds their capacity to manage it effectively.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Personalization -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Personalization">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion where the student takes excessive personal blame for negative academic outcomes. </rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior"/>
        <rdfs:comment>Self-reported behaviors indicating academic task avoidance patterns, including task postponement, early give up, and hopelessness about studying.</rdfs:comment>
        <rdfs:comment>Self-reported physical complaints associated with academic stress or cognitive drift, including headache, sleep difficulty, and physical restlessness.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalStressComplaint -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalStressComplaint">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates physical symptoms reported by a student that are associated with academic stress.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ResourceRecommendation -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#ResourceRecommendation">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput"/>
        <rdfs:comment>A set of recommended support resources or coping strategies suggested to the student based on their inferred state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfReportedBehavior">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>Represents behavioral signals self-reported by the student via a structured checklist during an academic session.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SelfTalkEntry">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>Represents a student&apos;s written (via keyboard) self-talk text submitted during an academic session, used for NLP feature extraction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DriftState"/>
        <rdfs:comment>Inferred when high-severity cognitive distortions co-occur with memory, attention, and stress indicators across multiple modalities, requiring immediate counselor follow-up.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState"/>
        <rdfs:comment>Inferred when multiple high-severity stress indicators co-occur including physical complaints and helplessness, warranting counselor awareness.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ShouldStatements -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#ShouldStatements">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>A cognitive distortion characterized by rigid self-directed rules and excessive self-criticism using language such as I should, I must, or I have 
to.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SleepDifficulty -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SleepDifficulty">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PhysicalStressComplaint"/>
        <rdfs:comment>Self-reported difficulty sleeping due to academic worries or stress.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SlowedThinking -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SlowedThinking">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>Indicates a student&apos;s self-reported or speech-based evidence of reduced cognitive processing speed during academic work.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SocialAcademicPressure -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SocialAcademicPressure">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AcademicStressIndicator"/>
        <rdfs:comment>Indicates stress arising from social comparison, peer competition, or external expectations in the academic environment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SpeechSample">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InputSignal"/>
        <rdfs:comment>Represents a short speech recording submitted by a student, transcribed and analyzed for pace, hesitation, and tone indicators.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressProgression">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Tracks how a student&apos;s inferred state has changed across multiple sessions over time.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#StressState">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InferredState"/>
        <rdfs:comment>Represents an inferred state where academic stress indicators are present but cognitive drift has not yet been detected.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Student -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Represents a university student in a STEM or Computing discipline who submits self-talk, speech, and behavioral data for cognitive drift monitoring.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#StudentAwarenessMessage -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#StudentAwarenessMessage">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput"/>
        <rdfs:comment>A supportive awareness message displayed to the student describing their inferred state in plain non-clinical language.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#SupportOutput">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Represents the type of support action or output recommended based on the student&apos;s inferred state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#WorkingMemoryLapse -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#WorkingMemoryLapse">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CognitiveDriftIndicator"/>
        <rdfs:comment>Indicates lapses in working memory during academic tasks such as forgetting recently studied content or losing train of thought.</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AllOrNothingThinking"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#CounselorAlert_Output -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#CounselorAlert_Output">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#CounselorAlert"/>
        <owl:differentFrom rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#StudentAwarenessMessage_Output"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#DeadlinePressure_Ind -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#DeadlinePressure_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#DeadlinePressure"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift"/>
        <owl:differentFrom rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#MildStress_State"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#EmotionalReasoning_Ind -->

    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#EmotionalReasoning_Ind">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EmotionalReasoning"/>
    </owl:NamedIndividual>
    


    <!-- http://kduresearch.ac.lk/ontologies/cognitive-drift#ExamAnxiety_Ind -->

