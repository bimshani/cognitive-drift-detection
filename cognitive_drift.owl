                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    


    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Attention loss combined with a working memory lapse is itself an early drift signal, independent of any academic stress indicator. Added to close a coverage gap: a student reporting both was previously left without any inferred state.</rdfs:comment>
        <rdfs:label>R30_EarlyDrift_AttentionMemory</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WorkingMemoryLapse_Ind"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>R20_ModerateDrift_Speech</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SlowedThinking_Ind"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSession"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                                <swrl:argument2 rdf:resource="urn:swrl:var#sess"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSpeechSample"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#sess"/>
                                                        <swrl:argument2 rdf:resource="urn:swrl:var#sp"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                        <rdf:first>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#speech_hasHesitationCount"/>
                                                                <swrl:argument1 rdf:resource="urn:swrl:var#sp"/>
                                                                <swrl:argument2 rdf:resource="urn:swrl:var#h"/>
                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                                                        <swrl:arguments>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first rdf:resource="urn:swrl:var#h"/>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first>
                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </swrl:arguments>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#ModerateDrift_State"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>R28_StressProgressesToDrift</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereStress_State"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#AttentionLoss_Ind"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#EarlyDrift_State"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>R21_SevereDrift</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#WorkingMemoryLapse_Ind"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                                <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SlowedThinking_Ind"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                                                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                                                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PerceivedOverload_Ind"/>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasInferredState"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SevereDrift_State"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>

    <!-- ===================== CROSS-SESSION PROGRESSION (added) ===================== -->

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PreviousSessionRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>A compact record of the conclusions reached in ONE EARLIER session of the same student (severity ranks of the stress and drift states). One record is created per earlier session considered; the ontology never stores the earlier raw inputs. Rank scale: 0 = none, 1 = mild/early, 2 = moderate, 3 = severe.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PersistentStress">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <rdfs:comment>Stress has been at moderate level or higher in the current session and in the two sessions before it.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#RisingDrift">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <rdfs:comment>The cognitive drift state is higher than in the immediately previous session.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#InsufficientHistory">
        <rdfs:subClassOf rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#SessionStatus"/>
        <rdfs:comment>Fewer than two sessions exist for this student, so no progression can be judged yet.</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#PersistentStress_Status">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PersistentStress"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#RisingDrift_Status">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#RisingDrift"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#InsufficientHistory_Status">
        <rdf:type rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#InsufficientHistory"/>
    </owl:NamedIndividual>

    <owl:ObjectProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSession">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PreviousSessionRecord"/>
        <rdfs:comment>Connects the student (current session) to a record of one earlier session. Asserted by the pipeline from stored results; used by the progression rules R34-R40.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentStressRank">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Severity rank of the headline stress state of the CURRENT session (0 none, 1 mild, 2 moderate, 3 severe). Asserted by the pipeline after the highest-severity arbitration step.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentDriftRank">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Severity rank of the headline drift state of the CURRENT session (0 none, 1 early, 2 moderate, 3 severe).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasStressRank">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PreviousSessionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Stress severity rank concluded for that earlier session.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasDriftRank">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PreviousSessionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Drift severity rank concluded for that earlier session.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasRecency">
        <rdfs:domain rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#PreviousSessionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>How many sessions ago this record is: 1 = the session immediately before the current one, 2 = the one before that.</rdfs:comment>
    </owl:DatatypeProperty>

