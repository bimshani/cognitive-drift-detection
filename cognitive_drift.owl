                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#exhibitsIndicator"/>
                        <swrl:argument1 rdf:resource="urn:swrl:var#p"/>
                        <swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Catastrophizing_Ind"/>
                    </rdf:Description>
