        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasSessionStatus"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#RisingDrift_Status"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
