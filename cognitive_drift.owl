    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Drift rank of the current session is higher than in the previous session and at least EARLY (rank 1).</rdfs:comment>
