    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Stress rank of the current session is HIGHER than in the immediately previous session.</rdfs:comment>
        <rdfs:label>R34_StressWorsening</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#c"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#r1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasRecency"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:resource="urn:swrl:var#pv"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#c"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#pv"/><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasProgressionRecord"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Worsening_Progression"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Stress rank of the current session is LOWER than in the immediately previous session.</rdfs:comment>
        <rdfs:label>R35_StressImproving</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#c"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#r1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasRecency"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:resource="urn:swrl:var#pv"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#c"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#pv"/><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasProgressionRecord"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Improving_Progression"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Stress rank of the current session equals that of the immediately previous session.</rdfs:comment>
        <rdfs:label>R36_StressStable</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#c"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#r1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasRecency"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:resource="urn:swrl:var#pv"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#equal"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#c"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#pv"/><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasProgressionRecord"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Stable_Progression"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>Stress at MODERATE (rank 2) or higher in the current session and in each of the two sessions before it.</rdfs:comment>
        <rdfs:label>R37_PersistentStress</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#Student"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasCurrentStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#c"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#c"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSession"/><swrl:argument1 rdf:resource="urn:swrl:var#p"/><swrl:argument2 rdf:resource="urn:swrl:var#r1"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasRecency"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#prev_hasStressRank"/><swrl:argument1 rdf:resource="urn:swrl:var#r1"/><swrl:argument2 rdf:resource="urn:swrl:var#a"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/><swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/><swrl:arguments><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:resource="urn:swrl:var#a"/><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:arguments></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://kduresearch.ac.lk/ontologies/cognitive-drift#hasPreviousSe